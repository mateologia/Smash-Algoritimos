{
    "configurations": [
        {
            "name": "macOS",
            "includePath": [
                "${workspaceFolder}/Smash/**",
                "/opt/homebrew/opt/raylib/include",
                "/usr/local/opt/raylib/include"
            ],
            "compilerPath": "/usr/bin/cc",
            "cStandard": "c99",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/Smash/**",
                "/usr/local/include"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c99",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
